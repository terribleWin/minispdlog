@startuml minispdlog_architecture

title minispdlog 0.1.0 — 同步、异步与耐久写入
left to right direction
skinparam backgroundColor #FAFBFD
skinparam shadowing false
skinparam roundcorner 12
skinparam linetype ortho
skinparam packageStyle rectangle
skinparam componentStyle rectangle
skinparam defaultFontName Microsoft YaHei
skinparam ArrowColor #546E7A
skinparam component {
  BackgroundColor #EEF5FF
  BorderColor #4E79A7
  FontColor #19324D
}
skinparam database {
  BackgroundColor #FFF5E6
  BorderColor #D98C2B
}
skinparam queue {
  BackgroundColor #F4EEFF
  BorderColor #7A5AA6
}
skinparam note {
  BackgroundColor #FFFBEA
  BorderColor #C5A640
}

actor "业务线程" as caller

package "公共 API" as api {
  component "全局函数 / 工厂\nminispdlog.h" as public_api
  component "registry\n具名与默认 logger" as registry
  component "logger\n级别、Sink 快照、fmt 参数展开" as logger
  component "async_logger\n投递/同步退化" as async_logger
}

package "异步执行层" as async_layer {
  component "thread_pool_manager\n全局池 + generation" as pool_manager
  component "thread_pool\nwake / flush ack / shutdown" as pool
  queue "blocking MPMC\nblock / overrun_oldest / discard_new" as mpmc
  queue "lock-free MPSC\n1 worker；block / discard_new" as mpsc
  component "工作线程\nbackend_sink_it_" as worker
}

package "记录与格式化" as formatting {
  component "log_msg\ntime / level / tid / pid / source / payload" as log_msg
  component "async_msg\n拥有 payload；256 B 内联" as async_msg
  component "pattern_formatter\n预编译 pattern" as pattern
  component "json_formatter\nJSON Lines + 资源字段" as json
}

package "输出层" as output {
  component "base_sink<Mutex>\n级别 + formatter + 复用缓冲" as base_sink
  component "console / color" as console
  component "file / rotating / daily" as files
  component "callback / Qt" as callback
  component "Linux UDP / TCP" as network
  component "buffered_file_sink\n双缓冲 + 批次" as buffered
  component "json_sink_wrapper\n默认锁定 JSON" as json_sink
}

package "耐久文件层" as durable_layer {
  component "durable_file\n阈值、交换、恢复" as durable
  database "主日志文件" as main_file
  database "sidecar WAL\n偏移 + 完整记录前缀" as wal
}

caller --> public_api : 全局 API / 创建 logger
caller --> logger : 同步 log()
caller --> async_logger : 异步 log()

public_api --> registry : 注册 / 查找 / flush_all
registry o-- logger
logger <|-- async_logger

logger --> log_msg : 调用线程展开 fmt\n并捕获元数据
log_msg --> base_sink : 同步 sink_it_

async_logger --> pool_manager : 取得当前 generation 的池
pool_manager o-- pool
pool --> mpmc : queue_type=blocking
pool --> mpsc : queue_type=lockfree
log_msg --> async_msg : 深拷贝 payload
async_logger --> async_msg
async_msg --> mpmc
async_msg --> mpsc
mpmc --> worker
mpsc --> worker
worker --> base_sink : backend_sink_it_

base_sink o-- pattern : 默认 / set_pattern
base_sink o-- json : set_formatter / JSON wrapper
base_sink <|-- console
base_sink <|-- files
base_sink <|-- callback
base_sink <|-- network
base_sink <|-- buffered
json_sink ..> buffered : 包装一种底层 Sink
json_sink ..> files
json_sink ..> console
json_sink ..> network

buffered --> durable : append / begin_commit / write_commit
durable --> wal : recover=true 时先写
durable --> main_file : fwrite + durability
wal --> durable : 构造时回放
main_file --> durable : 256 KiB 尾部断行修复

note top of logger
  logger 的 Sink 列表写时复制。
  记录路径只读取 shared_ptr 快照；
  每个 Sink 独占 formatter。
end note

note bottom of pool
  flush 使用确认消息并等待未完成记录。
  shutdown：刷新 registry → 停池并 join → drop_all。
end note

note bottom of durable
  max_age 没有独立计时线程，
  在下一条记录或显式 flush 时生效。
  恢复依赖每条记录以换行结束。
end note

note right of network
  当前仅 Linux 提供真实内核 Socket；
  非 Linux 构造时明确失败。
end note

legend right
  |= 路径 |= 线程位置 |
  | 同步 | 调用线程完成 formatter 与 Sink I/O |
  | 异步前半 | 调用线程展开 fmt 并入队 |
  | 异步后半 | 工作线程完成 formatter 与 Sink I/O |
  | durable | Sink 下层的批量提交与恢复 |
endlegend

@enduml
